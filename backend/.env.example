# ===========================================
# LLM API Keys (テーマ生成用)
# ===========================================
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ===========================================
# Session Configuration
# ===========================================
SESSION_SECRET=change_me_to_random_string_in_production

# ===========================================
# Event Configuration
# ===========================================
EVENT_PASSPHRASE=your_event_passphrase

# ===========================================
# Discord OAuth Configuration
# ===========================================
# Discord Developer Portal で取得:
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:4000/auth/discord/callback

# ===========================================
# Admin Configuration
# ===========================================
# 初期管理者の Discord User ID
# DiscordでユーザーIDを取得するには:
# 1. Discordの設定 > 詳細設定 > 開発者モードを有効化
# 2. ユーザーを右クリック > 「IDをコピー」
SUPER_ADMIN_DISCORD_ID=your_discord_user_id
